import random
import functools

def retry(count=5):
    def decorator(func):
        @functools.wraps(func)
        def wrapper(*args, **kwargs):
            for attempt in range(count):
                try:
                    return func(*args, **kwargs)
                except ValueError:
                    if attempt == count - 1:
                        raise
                    print(f"Попытка {attempt + 1}: ValueError, повторяем...")
                except OSError:
                    print(f"{func.__name__} raise OsError exception.")
                    if attempt == count - 1:
                        raise
            return None

        return wrapper

    return decorator


exceptions = (ValueError, OSError)


@retry(count=5)
def random_exception() -> float:
    if (d := random.random()) > 0.5:
        raise random.choice(exceptions)
    return d


if __name__ == "__main__":
    for _ in range(100):
        try:
            print("result:", random_exception())
        except (ValueError, OSError):
            print("Не удалось после 5 попыток")
