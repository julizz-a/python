n = int(input("Кол-во человек: "))
k = int(input("Какое число в считалке? "))
print(f"Значит, выбывает каждый {k}-й человек\n")

people = list(range(1, n + 1))

current_index = 0

while len(people) > 1:
    print(f"Текущий круг людей: {people}")
    print(f"Начало счёта с номера {people[current_index]}")

    index_to_remove = (current_index + k - 1) % len(people)

    print(f"Выбывает человек под номером {people[index_to_remove]}\n")

    people.pop(index_to_remove)

    current_index = index_to_remove % len(people) if people else 0

print(f"Остался человек под номером {people[0]}")
