skates_count = int(input("Кол-во коньков: "))
skates = []

for i in range(1, skates_count + 1):
    size = int(input(f"Размер {i}-й пары: "))
    skates.append(size)

people_count = int(input("\nКол-во людей: "))
people = []

for i in range(1, people_count + 1):
    size = int(input(f"Размер ноги {i}-го человека: "))
    people.append(size)

skates.sort()
people.sort()

i = 0
j = 0
count = 0

while i < len(skates) and j < len(people):
    if skates[i] == people[j]:
        count += 1
        i += 1
        j += 1
    else:
        i += 1

print(f"\nНаибольшее кол-во людей, которые могут взять ролики: {count}")
